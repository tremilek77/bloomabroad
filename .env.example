# Copy this file to `.env` and fill in your Supabase project values.
# Both are safe to ship in the client bundle (the anon key is public and
# gated by Row-Level Security). Find them in Supabase → Project Settings → API.
#
# If these are left blank, the app falls back to browser localStorage.

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
